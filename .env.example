# LOCAL DEVELOPMENT ONLY. Copy to .env (ignored by Git).
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional for local demos. Production startup rejects this flag.
DJANGO_ALLOW_DEMO_POSTS=true
# A random process-local signing key is generated in DEBUG if unset.
# DJANGO_SECRET_KEY=

# In hosting settings (not this file):
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<generate a fresh random key of at least 50 characters>
# DJANGO_ALLOWED_HOSTS=your-service.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# DJANGO_ALLOW_DEMO_POSTS=false
# Enable only behind a trusted proxy which sanitizes forwarded headers:
# DJANGO_TRUST_PROXY_SSL_HEADER=true
# DJANGO_SQLITE_PATH=/path/on/persistent/disk/db.sqlite3
